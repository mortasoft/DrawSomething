# Puerto interno del servidor Express / Socket.IO (local y dentro del contenedor)
PORT=3001

# Puerto expuesto en el host al ejecutar con Docker Compose
APP_PORT=8088

# Contraseña para iniciar sesión en /admin (obligatorio cambiar en producción)
ADMIN_PASSWORD=cambia-esta-contrasena-segura

# Secreto HMAC para firmar los tokens de sesión de /admin (si se omite, se genera al iniciar)
ADMIN_SESSION_SECRET=cambia-este-secreto-aleatorio-de-64-caracteres

# Ruta del archivo JSON donde se persisten las palabras
WORDS_DATA_PATH=./data/words.json
